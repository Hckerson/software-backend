DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
# Generate with: pnpm keys:generate  (base64-encoded PEM, one line each)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
PORT=5000

# Billing cycle scheduler. Runs daily at 02:00. @nestjs/schedule is in-process,
# so with more than one API instance set this to "off" on all but one.
BILLING_CYCLE_CRON=on

# Password reset delivery. With SMTP_HOST unset the link is written to the log
# instead of sent, so the app still boots unconfigured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
