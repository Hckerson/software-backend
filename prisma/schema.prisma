// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS: User Domain
// ============================================================================

enum Day {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum Month {
  JAN
  FEB
  MAR
  APR
  MAY
  JUN
  JUL
  AUG
  SEP
  OCT
  NOV
  DEC
}

enum UserRole {
  ADMIN
  USER
}

enum UserAccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

// ============================================================================
// ENUMS: Billing Domain
// ============================================================================

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  FAILED
  OVERDUE
}

enum UsageMetricType {
  API_CALLS
  STORAGE_GB
  SEATS
}

// ============================================================================
// MODEL: User
// ============================================================================

model User {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  passwordHash String
  phoneNumber  String?
  avatar       String?
  bio          String?
  year         Int
  day          Day
  month        Month
  lastActive     DateTime? @default(now())
  passwordResetAt DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  role   UserRole
  status UserAccountStatus @default(ACTIVE)

  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
  invoices       Invoice[]
}

// ============================================================================
// MODEL: SubscriptionPlan
// ============================================================================

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  priceUSD    Decimal  @db.Decimal(10, 2)
  features    Json
  limits      Json
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  planType PlanType

  subscriptions Subscription[]
}

// ============================================================================
// MODEL: Subscription
// ============================================================================

model Subscription {
  id                        String    @id @default(uuid())
  userId                    String
  planId                    String
  startDate                 DateTime  @default(now())
  renewalDate               DateTime
  canceledAt                DateTime?
  currentBillingPeriodStart DateTime  @default(now())
  currentBillingPeriodEnd   DateTime
  updatedAt                 DateTime  @updatedAt
  createdAt                 DateTime  @default(now())

  status SubscriptionStatus @default(ACTIVE)

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices      Invoice[]
  usageLogs     UsageLog[]
  billingAudits BillingAudit[]

  @@unique([userId, status])
  @@index([userId])
  @@index([planId])
}

// ============================================================================
// MODEL: Invoice
// ============================================================================

model Invoice {
  id                 String    @id @default(uuid())
  subscriptionId     String
  userId             String
  amount             Decimal   @db.Decimal(12, 2)
  stripeInvoiceId    String?
  paidDate           DateTime?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  status InvoiceStatus @default(DRAFT)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, billingPeriodStart])
  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
}

// ============================================================================
// MODEL: UsageLog
// ============================================================================

model UsageLog {
  id             String   @id @default(uuid())
  subscriptionId String
  amount         Int
  period         String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  metricType UsageMetricType

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, metricType, period])
  @@index([subscriptionId])
  @@index([period])
}

// ============================================================================
// MODEL: PaymentMethod
// ============================================================================

model PaymentMethod {
  id          String   @id @default(uuid())
  userId      String
  stripeToken String
  last4Digits String
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// MODEL: BillingAudit
// ============================================================================

model BillingAudit {
  id             String   @id @default(uuid())
  subscriptionId String
  action         String
  oldValue       Json?
  newValue       Json?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}
